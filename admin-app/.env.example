# OneGrid content admin — environment variables
#
# On Render: add these under the service's "Environment" tab (you can paste this file's contents
# with "Add from .env"). Locally: copy this file to admin-app/.env and fill it in — the app loads it
# automatically when it starts (`node server.js`). Real environment variables override the file.
# .env is git-ignored, so it is never committed.
#
# Lines marked "required" must be set; the rest are optional. Sign-in methods and uploads switch
# on automatically when their variables are filled in.

# ─── Core (required) ─────────────────────────────────────────────────────────────────────────────

# Secret key (at least 32 characters) that signs every JWT — login cookies and emailed sign-in
# links (HS256). Generate with: openssl rand -hex 32. Changing it signs everyone out.
# (The older name SESSION_SECRET also works.)
JWT_SECRET=

# MongoDB Atlas connection string — stores the team, login links, rate limits and activity log.
# Atlas → Connect → Drivers → Node.js. (Optional only in local mode: then data is kept in memory.)
MONGODB_URI=

# The admin's own address, no trailing slash. Used for Google sign-in and emailed links.
# e.g. https://onegrid-admin.onrender.com or https://admin.onegridenergies.com
PUBLIC_URL=http://localhost:3000

# GitHub fine-grained token with "Contents: Read and write" on OneGrid-Energies/onegrid-web.
GITHUB_TOKEN=

# Comma-separated emails that are always owners (can't be removed from inside the app).
OWNER_EMAILS=you@example.com

# ─── First sign-in (optional) ────────────────────────────────────────────────────────────────────

# Lets an OWNER_EMAILS owner sign in with this password before setting their own.
# Remove it after your first sign-in.
OWNER_INITIAL_PASSWORD=

# ─── Repository & website (optional — defaults shown) ────────────────────────────────────────────

MONGODB_DB=onegrid_webadmin
GITHUB_REPO=OneGrid-Energies/onegrid-web
GITHUB_BRANCH=master
SITE_URL=https://onegridenergies.com

# "github" (default) saves through GitHub. "local" edits the files in this checkout instead and
# prints emails to the terminal — for development only.
CONTENT_BACKEND=github

# Port to listen on (Render sets this automatically) and how long sign-ins last.
PORT=3000
SESSION_DAYS=14

# ─── Google sign-in (optional) ───────────────────────────────────────────────────────────────────
# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <PUBLIC_URL>/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Emailed sign-in links & password resets via Brevo (optional) ────────────────────────────────
# Brevo → SMTP & API → API Keys. MAIL_FROM must be a sender verified in Brevo.

BREVO_API_KEY=
MAIL_FROM=OneGrid Admin <admin@onegridenergies.com>

# ─── Photo & video uploads via Cloudinary (optional) ─────────────────────────────────────────────
# Cloudinary → Settings → API Keys. Uploads are signed on the server and limited to the folder.

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=dj2ciluyx
CLOUDINARY_FOLDER=onegrid
